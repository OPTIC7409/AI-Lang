# Valid programs that the static type checker must accept. Every pattern
# here is legal; a false "type error found before running" fails this file.

type Point = { x: Float, y: Float }
type Tree[T] = Leaf | Node(Tree[T], T, Tree[T])
type Shape = Circle(radius: Float) | Square(side: Float)

fn first[T](xs: List[T]) -> Option[T] => xs.get(0)

fn area(s: Shape) -> Float => match s {
  Circle(r) => pi * r * r
  Square(a) => a * a
}

fn mean(xs: List[Float]) -> Float => xs.sum() / xs.len()

fn find_positive(xs: List[Int]) -> Int {
  for x in xs {
    if x > 0 {
      return x
    }
  }
  -1
}

fn spin(n: Int) -> Int {
  var i = 0
  while true {
    i += 1
    if i >= n {
      return i
    }
  }
  0
}

fn origin() -> Point => { x: 0.0, y: 0.0 }

fn describe(x) -> Str => "{x}"

fn count_leaves(t: Tree[Int]) -> Int => match t {
  Leaf => 1
  Node(l, _, r) => count_leaves(l) + count_leaves(r)
}

fn len(p: Point) -> Float => hypot(p.x, p.y)

test "Ints are accepted where Floats are declared" {
  assert mean([1, 2, 3]) == 2.0
  let f: Float = 3
  assert f == 3.0
  var p = Point(1, 2)
  p.x = 5
  assert p.x == 5.0
}

test "generic functions and types" {
  assert first([1, 2]) == Some(1)
  assert first(["a"]) == Some("a")
  let t: Tree[Int] = Node(Leaf, 1, Node(Leaf, 2, Leaf))
  assert count_leaves(t) == 3
  let o: Option[Float] = Some(1)
  assert o == Some(1.0)
}

test "returns from inside loops" {
  assert find_positive([-1, 3]) == 3
  assert spin(3) == 3
}

test "anonymous records become declared records" {
  assert origin() == Point(0.0, 0.0)
}

test "unannotated values are not checked early" {
  assert describe(1) == "1"
  assert describe([1, "a"]) == "[1, \"a\"]"
  var v = 1
  v = "now a string"
  assert v == "now a string"
}

test "branches of different types" {
  let x = if 1 < 2 { 1 } else { 2.5 }
  assert x == 1
  let y = match Some(3) {
    Some(n) => n
    None => "none"
  }
  assert y == 3
}

test "overloads and functions named like built-ins" {
  assert len(Point(3, 4)) == 5.0
  assert len([1, 2]) == 2
}

test "closures and captured values" {
  let k: Int = 10
  let add = fn(n: Int) -> Int => n + k
  assert add(5) == 15
  assert [1, 2].map(fn(n) => n * k) == [10, 20]
}

test "records keep their declared type through field writes" {
  var p = Point(1.0, 2.0)
  p.y = 7
  p.x += 1
  assert p == Point(2.0, 7.0)
}

test "operators on known types" {
  assert "ab" * 2 == "abab"
  assert [0] * 3 == [0, 0, 0]
  assert 7 / 2 == 3.5 and 7 // 2 == 3
  assert [1] + [2] == [1, 2]
  assert (1, "a") < (2, "a")
}
