# Regression tests for issues found by the second round of AI dogfooding.

import "lib/queue.cog"

type Heap = { items: List[Int] }

fn set_at!(xs: List[Int], i: Int, v: Int) {
  xs[i] = v
}

fn put!(m: Map[Str, Int], k: Str, v: Int) {
  m[k] = v
}

test "typed writes stay checked after many fast writes" {
  var xs: List[Int] = [0] * 100
  for i in 0..100 {
    xs[i] = i
    xs.swap!(0, i)
  }
  assert xs.sum() == 4950
  let r = catch(fn() => {
    var ys: List[Int] = [0] * 10
    for i in 0..10 { ys[i] = i }
    ys.swap!(1, 2)
    ys.pop!()
    ys.push!("x")
    ys
  })
  assert r.is_err()
}

test "mutating functions with annotated parameters keep checking" {
  var zs = [0] * 50
  for i in 0..50 { zs.set_at!(i, i * 2) }
  assert zs[49] == 98
  let r = catch(fn() => {
    var bad = [1, 2, 3]
    bad.set_at!(0, 1)
    var worse = [1, "two"]
    worse.set_at!(0, 1)
  })
  assert r.is_err()
}

test "map keys are checked against the declared key type" {
  var m: Map[Str, Int] = [:]
  m.put!("a", 1)
  m["b"] = 2
  assert m.len() == 2
  let r = catch(fn() => {
    var n: Map[Str, Int] = [:]
    n[5] = 1
    n
  })
  assert r.is_err()
}

test "writes through a nominal record field are checked without an annotation" {
  var h = Heap(items: [1, 2, 3])
  h.items[0] = 10
  h.items.swap!(0, 2)
  assert h.items == [3, 2, 10]
  let r = catch(fn() => {
    var g = Heap(items: [1])
    g.items[0] = "x"
    g
  })
  assert r.is_err()
}

test "nested typed collections" {
  var grid: List[List[Int]] = [[0] * 3 for _ in 0..3]
  grid[1][2] = 5
  grid[0].push!(7)
  assert grid[1][2] == 5 and grid[0].len() == 4
  let r = catch(fn() => {
    var g: List[List[Int]] = [[0]]
    g[0][0] = 1
    g[0].push!(2.5)
    g
  })
  assert r.is_err()
}

property "length filters are satisfied by the generator" (xs: List[Int]) where xs.len() >= 3 {
  assert xs.len() >= 3
}

property "where clauses can use names from parameter patterns" ((a, b): (Int, Int)) where b != 0 {
  assert (a * b) // b == a
}

property "float bounds are steered" (r: Float) where r > 0.0 and r < 1000.0 {
  assert r > 0.0 and r < 1000.0
}

type Pt = { x: Int, y: Int }

fn sum_pt(Pt(x, y): Pt) -> Int => x + y

fn apply(f: fn(Int) -> Int, x: Int) -> Int => f(x)

test "string functions that pick characters return a Str" {
  assert "123abc".take_while(fn(c) => c.is_digit()) == "123"
  assert "  x".drop_while(fn(c) => c == " ") == "x"
  assert "hello".filter(fn(c) => c != "l") == "heo"
  assert "cba".sort() == "abc"
  assert "banana".unique() == "ban"
  assert "abcdef".chunks(2) == ["ab", "cd", "ef"]
  assert "abcd".windows(3) == ["abc", "bcd"]
}

test "map predicates may take the key and value separately" {
  let m = ["a": 1, "b": 2, "c": 3]
  assert m.count(fn(k, v) => v > 1) == 2
  assert m.any(fn(k, v) => k == "c")
  assert m.all(fn(k, v) => v > 0)
  assert m.find(fn(k, v) => v == 2) == Some(("b", 2))
}

test "formatting rounds halves the same way as round" {
  assert "{2.5:.0}" == "3" and round(2.5) == 3
  assert fixed(0.125, 2) == "0.13" and round(0.125, 2) == 0.13
  assert "{0.125:.2}" == "0.13"
  assert "{1500.0:.1e}" == "1.5e+03"
}

test "hashed raw strings may contain quotes" {
  let j = r#"{"name": "Ada"}"#
  assert j.len() == 15
  assert parse_json(j).is_ok()
  assert r##"a "# b"## == "a \"# b"
}

test "indexing non-ASCII text" {
  let s = "é" + "ab" * 100 + "中"
  assert s[0] == "é" and s[1] == "a" and s[201] == "中" and s[-1] == "中"
  assert s[199..202] == "ab中"
  assert [s[i] for i in 0..s.len()].join("") == s
}

test "constructor patterns in parameters" {
  assert sum_pt(Pt(2, 3)) == 5
}

test "function-typed parameters check the number of arguments" {
  assert apply(fn(a) => a + 1, 1) == 2
  assert catch(fn() => apply(fn(a, b) => a, 1)).is_err()
}

test "JSON object keys must stay distinct strings" {
  assert to_json([1: "a"]) == r#"{"1":"a"}"#
  assert catch(fn() => to_json([1: "a", "1": "b"])).is_err()
  assert catch(fn() => to_json([(1, 2): "a"])).is_err()
}

test "a module's functions come first in method syntax, mutating ones too" {
  var q = queue.new()
  q.push!(3)
  q.push!(4)
  assert q.len() == 2 and q.items == [3, 4]
}

var typed_list: List[Int] = [1]

test "a failed mutation leaves the variable unchanged" {
  assert catch(fn() => typed_list.push!("s")).is_err()
  assert typed_list == [1]
  var f: List[Float] = []
  f.push!(1)
  f.extend!([2, 3])
  assert f == [1.0, 2.0, 3.0] and type_of(f[0]) == "Float"
}

test "annotations on destructuring bindings are enforced" {
  var (a, b): (Int, Str) = (1, "x")
  a = 2
  assert a == 2 and b == "x"
  assert catch(fn() => { var (c, _d): (Int, Int) = (1, 2); c = "no"; c }).is_err()
}

test "inclusive slices may end at a negative index" {
  assert [1, 2, 3][-2..=-1] == [2, 3]
  assert [1, 2, 3][..=-1] == [1, 2, 3]
  assert "abc"[..=-1] == "abc"
  assert [1, 2, 3][..=-2] == [1, 2]
}

test "formatting edge cases" {
  assert "{1e16:,}" == "1e16"
  assert "{inf:010}" == "       inf"
  assert "{1234567.5:,}" == "1,234,567.5"
}

test "split with an empty separator respects the limit" {
  assert "abc".split("", 2) == ["a", "bc"]
  assert "abc".split("", 1) == ["abc"]
}

test "a Float equal to an Int is the same map key" {
  let f = float(min_int)
  assert [min_int: 1].has(f)
  assert [min_int, f].unique().len() == 1
}

test "shared structure is compared and hashed quickly" {
  var x = [1]
  var y = [1]
  for _ in 0..60 {
    x = [x, x]
    y = [y, y]
  }
  assert x == y
  assert [x: 1].has(y)
  assert compare(x, y) == Equal
}

test "anonymous records with fields in another order can be ordered" {
  assert { a: 0, b: 9 } < { b: 0, a: 1 }
}

test "built-ins take named arguments in each of their forms" {
  assert len(x: [1, 2]) == 2
  assert Some(1).unwrap_or(default: 3) == 1
  assert remove(["a": 1, "b": 2], k: "a") == ["b": 2]
  assert remove([1, 2, 3], i: 0) == [2, 3]
}

property "a minimum string length steers generation" (s: Str) where s.len() > 30 {
  assert s.len() > 30
}

type Slot = Empty | Full(Int)

test "is tests a value against a pattern" {
  let slots = [Full(1), Empty, Full(3)]
  assert slots.count(fn(s) => s is Full(_)) == 2
  assert Some(3) is Some(1..=5)
  assert not (None is Some(_))
  assert [1, 2] is [_, _]
  assert [s for s in slots if s is Empty | Full(1)] == [Full(1), Empty]
}

test "parse_int takes a base" {
  assert parse_int("ff", 16) == Some(255)
  assert parse_int("0xff", 16) == Some(255)
  assert parse_int("-101", 2) == Some(-5)
  assert parse_int("12", 2) == None
  assert parse_int("-9223372036854775808") == Some(min_int)
  assert parse_int("9223372036854775808") == None
}

test "wrapping arithmetic and hashing" {
  assert wrapping_add(max_int, 1) == min_int
  assert wrapping_sub(min_int, 1) == max_int
  assert wrapping_mul(shl(1, 62), 4) == 0
  assert hash([1, 2]) == hash([1.0, 2])
}

var word_counts: Map[Str, Int] = [:]

test "update! changes one map entry" {
  for w in "a b a c a b".words() {
    word_counts.update!(w, 0, fn(n) => n + 1)
  }
  assert word_counts == ["a": 3, "b": 2, "c": 1]
  assert catch(fn() => word_counts.update!("z", 0, fn(n) => "bad")).is_err()
  assert not word_counts.has("z")
  assert ["x": 1].update("y", 5, fn(n) => n + 1) == ["x": 1, "y": 6]
}
