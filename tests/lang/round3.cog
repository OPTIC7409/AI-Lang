# Regressions found by the third round of dogfooding.

import "lib/queue.cog"

test "a module's function may take more arguments than the built-in it shadows" {
  var q = queue.new()
  q.push!(1)
  q.insert!(0, 7, 2)
  insert!(q, 0, 9, 1)
  assert q.items == [9, 7, 7, 1]
  assert q.get(5, -1) == -1 and q.get(0, -1) == 9
}

fn lookup_twice(m: Map[Str, Int]) -> (Option[Int], Int) {
  # The body's `m.get` and `ys.len()` are the built-ins, not these locals.
  let get = fn(k) => m.get(k)
  let len = fn(ys) => ys.len() * 10
  (get("a"), len([1, 2]))
}

test "a local function named like a built-in does not take over method syntax" {
  assert lookup_twice(["a": 1]) == (Some(1), 20)
}

test "a local function is still callable with method syntax" {
  let double = fn(x) => x * 2
  assert 5.double() == 10
}

test "zero padding works for every number base" {
  assert "{10:04x}" == "000a"
  assert "{255:06X}" == "0000FF"
  assert "{5:08b}" == "00000101"
  assert "{-10:05x}" == "-000a"
  assert "{inf:05}" == "  inf"
  assert "{1234567:,}" == "1,234,567"
}

test "parse_float rejects nan and numbers too large for a Float" {
  assert parse_float("2.5") == Some(2.5)
  assert parse_float("nan") == None and parse_float("NaN") == None
  assert parse_float("1e999") == None
  assert parse_float("-inf") == Some(-inf)
  assert parse_float(str(inf)) == Some(inf)
  assert catch(fn() => float("nan")).is_err()
  assert catch(fn() => float("1e999")).is_err()
}

test "nan cannot be ordered" {
  let n = inf - inf
  assert is_nan(n)
  assert catch(fn() => n < 1.0).is_err()
  assert catch(fn() => 1.0 >= n).is_err()
  assert n != n
}

type Counter = { n: Int }

fn bump!(c: Counter) => c.n += 1

var hits = 0

test "an assignment can be the body of a `=>` function" {
  var c = Counter(n: 0)
  c.bump!()
  c.bump!()
  assert c.n == 2
  [1, 2, 3].each(fn(x) => hits += x)
  assert hits == 6
}

test "slices drop from either end" {
  let xs = [1, 2, 3, 4]
  assert xs[..-1] == [1, 2, 3] and xs[-2..] == [3, 4]
  assert "abc"[..-1] == "ab"
}

type Flags = { a: Bool, b: Int }

fn flag_value(p: Flags) -> Int => match p {
  { a: true, .. } => 1
  Flags(false, _) => 0
}

fn ends(xs: List[Bool]) -> Str => match xs {
  [] => "empty"
  [true, ..] => "starts T"
  [.., true] => "ends T"
  [false, .., false] => "F...F"
  [false] => "F"
}

test "record and constructor patterns of one type combine in a match" {
  assert flag_value(Flags(true, 5)) == 1 and flag_value(Flags(false, 5)) == 0
}

test "list patterns with a prefix and a suffix" {
  assert ends([false, true, false]) == "F...F"
  assert ends([false]) == "F" and ends([false, true]) == "ends T"
}

# Programs the static checker once rejected, though they run correctly.

type Box[T] = { v: T, n: Int }

type Pair[T] = { a: T, b: T }

fn relabel(b: Box[Int]) -> Box[Str] => { ..b, v: "x" }

fn first_field(r: { a: Int }) -> Int => r.b

fn wide() -> { a: Int } => { a: 1, b: 2 }

type Spot = { x: Float, y: Float }

fn spot_name(r: { x: Float, y: Float }) -> Str => match r {
  Spot(x, _) => "spot at {x}"
  _ => "other"
}

fn apply(f: fn(Int) -> Int) -> Str {
  let s: Str = f(1)
  s
}

fn first_even(xs: List[Int]) -> Int {
  for x in xs {
    if x % 2 == 0 {
      return x
    }
  }
  assert false, "no even number"
}

fn call_count(r) => r.count()

test "generic type arguments are not inferred from one constructor call" {
  assert relabel(Box(1, 0)).v == "x"
  var b = Box(1, 0)
  b.v = 2.5
  assert b.v == 2.5
  let p = Pair(1, "x")
  assert p.a + 1 == 2
}

test "a structural annotation accepts records with more fields" {
  assert first_field({ a: 1, b: 2 }) == 2
  assert wide().b == 2
  assert spot_name(Spot(1.0, 2.0)) == "spot at 1.0"
}

test "results of built-ins and function values" {
  let r: Range = range(3)
  assert r.to_list() == [0, 1, 2]
  let cs: List[Str] = shuffle("ab")
  assert cs.sort() == ["a", "b"]
  let port: Int = env("COGITO_TEST_UNSET").unwrap_or(8080)
  assert port == 8080
  assert apply(fn(x) => "got {x}") == "got 1"
  assert first_even([3, 4]) == 4
  assert call_count({ count: fn() => 7 }) == 7
}

test "get works on ranges, as indexing does" {
  assert (0..10).get(3) == Some(3) and (0..10).get(-1) == Some(9)
  assert (0..10).get(10) == None and (5..).get(2) == Some(7)
}
