# Functions, closures, overloading and pipelines.

fn add(a: Int, b: Int) -> Int => a + b

fn greet(name: Str, greeting: Str = "Hello") -> Str => "{greeting}, {name}!"

fn fact(n: Int) -> Int {
  if n <= 1 { return 1 }
  n * fact(n - 1)
}

test "calls, defaults and named arguments" {
  assert add(2, 3) == 5
  assert greet("Ada") == "Hello, Ada!"
  assert greet("Ada", "Hi") == "Hi, Ada!"
  assert greet(greeting: "Yo", name: "Bo") == "Yo, Bo!"
  assert greet("Cy", greeting: "Hey") == "Hey, Cy!"
  assert fact(10) == 3628800
}

test "method-call syntax calls a function with the receiver first" {
  assert 2.add(3) == 5
  assert "Ada".greet() == "Hello, Ada!"
  assert [3, 1, 2].sort().reverse() == [3, 2, 1]
}

test "pipelines insert the value as the first argument" {
  let r = [1, 2, 3, 4]
    |> map(fn(x) => x * 10)
    |> filter(fn(x) => x > 15)
    |> sum
  assert r == 90
  assert 5 |> add(1) == 6
}

test "closures capture values, not variables" {
  var n = 1
  let get = fn() => n
  n = 2
  assert get() == 1
  assert n == 2
}

test "closures returning closures" {
  let make_adder = fn(k) => fn(x) => x + k
  let add5 = make_adder(5)
  assert add5(10) == 15
  assert [1, 2].map(make_adder(1)) == [2, 3]
}

test "local functions can recurse" {
  fn fib(n: Int) -> Int {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
  }
  assert fib(15) == 610
  let memo_free = [0, 1, 2, 3].map(fib)
  assert memo_free == [0, 1, 1, 2]
}

test "local functions capture their surroundings" {
  let base = 100
  fn bump(x: Int) -> Int => x + base
  assert bump(1) == 101
  assert [1, 2].map(fn(x) => bump(x) * 2) == [202, 204]
}

type Circle = { r: Float }
type Square = { side: Float }

fn area(c: Circle) -> Float => 3.0 * c.r * c.r
fn area(s: Square) -> Float => s.side * s.side

test "overloading by parameter type" {
  assert Circle(r: 1.0).area() == 3.0
  assert Square(side: 2.0).area() == 4.0
  assert catch(fn() => area(5)).is_err()
}

fn len(c: Circle) -> Int => 42

test "user overloads extend built-in functions" {
  assert Circle(r: 1.0).len() == 42
  assert [1, 2, 3].len() == 3
  assert "ab".len() == 2
}

fn double_all!(xs: List[Int]) {
  for i in 0..xs.len() { xs[i] *= 2 }
}

fn push_twice!(xs: List[Int], x: Int) -> Int {
  xs.push!(x)
  xs.push!(x)
  xs.len()
}

test "user-defined mutating functions" {
  var v = [1, 2, 3]
  v.double_all!()
  assert v == [2, 4, 6]
  assert v.push_twice!(0) == 5
  assert v == [2, 4, 6, 0, 0]
  double_all!(v)
  assert v[0] == 4
}

test "higher-order built-ins" {
  let xs = [5, 3, 8, 1]
  assert xs.fold(0, fn(acc, x) => acc + x) == 17
  assert xs.reduce(fn(a, b) => max(a, b)) == 8
  assert xs.find(fn(x) => x > 4) == Some(5)
  assert xs.find_index(fn(x) => x == 8) == Some(2)
  assert xs.any(fn(x) => x > 7)
  assert not xs.all(fn(x) => x > 2)
  assert xs.count(fn(x) => x % 2 == 1) == 3
  assert xs.sort_by(fn(x) => -x) == [8, 5, 3, 1]
  assert xs.min() == Some(1)
  assert xs.max_by(fn(x) => x % 5) == Some(3)
  assert ["bb", "a", "ccc"].sort_with(fn(a, b) => compare(a.len(), b.len())) == ["a", "bb", "ccc"]
  assert xs.partition(fn(x) => x > 4) == ([5, 8], [3, 1])
  assert [[1, 2], [3]].flatten() == [1, 2, 3]
  assert [1, 2].flat_map(fn(x) => [x, x]) == [1, 1, 2, 2]
  assert ["a", "bb", "cc"].group_by(len) == [1: ["a"], 2: ["bb", "cc"]]
  assert "mississippi".chars().tally()["s"] == 4
  assert [1, 2, 3, 4, 5].chunks(2) == [[1, 2], [3, 4], [5]]
  assert [1, 2, 3].windows(2) == [[1, 2], [2, 3]]
  assert [1, 2, 1, 3].unique() == [1, 2, 3]
  assert [1, 2, 3].zip(["a", "b"]) == [(1, "a"), (2, "b")]
}

test "constructors are functions" {
  assert [1, 2].map(Some) == [Some(1), Some(2)]
}

test "functions are values" {
  let ops = [add, fn(a, b) => a * b]
  assert ops.map(fn(f) => f(3, 4)) == [7, 12]
}

test "Fn accepts functions of any arity" {
  let h: Fn = fn(a, b) => a + b
  assert h(1, 2) == 3
  fn call2(f: Fn, a: Int, b: Int) -> Int => f(a, b)
  assert call2(max, 3, 4) == 4
}

fn total!(xs: List[Float]) -> Float => xs.sum()

test "a ! function that only reads keeps the caller's value" {
  var ints: List[Int] = [1, 2]
  assert total!(ints) == 3.0
  assert ints == [1, 2] and type_of(ints[0]) == "Int"
}
