# Habits from other languages that `cogito fix` rewrites.
fn main() {
  var xs = [3, 1, 2]
  xs.sort()
  push(xs, 4)
  print(xs.len())
  print("abc".upper())
  let ok = true
  let s = "it's \"\{fine\}\""
  print(s)
  if not ok or xs.is_empty() { print("no") }
  if ok and true { print("yes") }
  var i = 0
  i += 1
  i -= 1
  let n = None
  print(n)
  if i == 0 { print("zero") }
  while i == 1 { i += 1 }
  let ys = [..xs, 5]
  print(ys)
  print(str(xs).starts_with("["))
  xs.reverse!()
  print("done")
  print(xs.len() > 3
    and ok)
}
fn f(x: Int) -> Str => "a"
fn g(m: Map[Str, Int]) -> Bool => m.has("a")
