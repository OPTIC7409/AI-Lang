# A tiny calculator language: a tokenizer, a recursive-descent parser and
# an evaluator, all written in Cogito.

type Token =
  | Num(Float)
  | Op(Str)
  | LParen
  | RParen

type Expr =
  | Lit(Float)
  | Neg(Expr)
  | Bin(op: Str, left: Expr, right: Expr)

fn tokenize(src: Str) -> Result[List[Token], Str] {
  var tokens = []
  let cs = src.chars()
  var i = 0
  while i < cs.len() {
    let c = cs[i]
    if c.is_space() {
      i += 1
    } else if c.is_digit() or c == "." {
      var j = i
      while j < cs.len() and (cs[j].is_digit() or cs[j] == ".") { j += 1 }
      let text = cs[i..j].join()
      let n = parse_float(text).ok_or("bad number `{text}`")?
      tokens.push!(Num(n))
      i = j
    } else if c in "+-*/^" {
      tokens.push!(Op(c))
      i += 1
    } else if c == "(" {
      tokens.push!(LParen)
      i += 1
    } else if c == ")" {
      tokens.push!(RParen)
      i += 1
    } else {
      return Err("unexpected character `{c}` at position {i}")
    }
  }
  Ok(tokens)
}

# Parser state is a value: each function returns the parsed expression and
# the remaining tokens.
type Parsed = Result[(Expr, List[Token]), Str]

fn precedence(op: Str) -> Int => match op {
  "+" | "-" => 1
  "*" | "/" => 2
  "^" => 3
  _ => 0
}

fn parse_expr(tokens: List[Token], min_prec: Int) -> Parsed {
  var (left, rest) = parse_atom(tokens)?
  loop {
    match rest {
      [Op(op), ..after] if precedence(op) >= min_prec => {
        # `^` is right-associative; the others are left-associative.
        let next = if op == "^" { precedence(op) } else { precedence(op) + 1 }
        let (right, rest2) = parse_expr(after, next)?
        left = Bin(op, left, right)
        rest = rest2
      }
      _ => break
    }
  }
  Ok((left, rest))
}

fn parse_atom(tokens: List[Token]) -> Parsed => match tokens {
  [Num(n), ..rest] => Ok((Lit(n), rest))
  [Op("-"), ..rest] => {
    let (e, rest2) = parse_atom(rest)?
    Ok((Neg(e), rest2))
  }
  [LParen, ..rest] => {
    let (e, rest2) = parse_expr(rest, 1)?
    match rest2 {
      [RParen, ..rest3] => Ok((e, rest3))
      _ => Err("expected `)`")
    }
  }
  [] => Err("unexpected end of input")
  _ => Err("unexpected token")
}

fn eval(e: Expr) -> Result[Float, Str] => match e {
  Lit(n) => Ok(n)
  Neg(x) => Ok(-eval(x)?)
  Bin(op, l, r) => {
    let a = eval(l)?
    let b = eval(r)?
    match op {
      "+" => Ok(a + b)
      "-" => Ok(a - b)
      "*" => Ok(a * b)
      "/" => if b == 0.0 { Err("division by zero") } else { Ok(a / b) }
      "^" => Ok(a ** b)
      _ => Err("unknown operator {op}")
    }
  }
}

fn calculate(src: Str) -> Result[Float, Str] {
  let tokens = tokenize(src)?
  let (e, rest) = parse_expr(tokens, 1)?
  if not rest.is_empty() {
    return Err("unexpected trailing input")
  }
  eval(e)
}

fn main() {
  for src in ["1 + 2 * 3", "(1 + 2) * 3", "2 ^ 3 ^ 2", "-4 + 10 / 4", "1 / (2 - 2)", "3 + * 4", "7 $ 2"] {
    match calculate(src) {
      Ok(v) => print("{src:<14} = {v}")
      Err(e) => print("{src:<14} ! {e}")
    }
  }
}

test "precedence and associativity" {
  assert calculate("1 + 2 * 3") == Ok(7.0)
  assert calculate("2 ^ 3 ^ 2") == Ok(512.0)
  assert calculate("10 - 4 - 3") == Ok(3.0)
  assert calculate("-(2 + 3)") == Ok(-5.0)
}

test "errors are values" {
  assert calculate("1 / 0") == Err("division by zero")
  assert calculate("(1 + 2") == Err("expected `)`")
  assert calculate("1 2").is_err()
}

property "addition of literals agrees with Cogito" (a: Int, b: Int) where a >= 0 and b >= 0 {
  assert calculate("{a} + {b}") == Ok(float(a + b))
}
