# Contracts make assumptions explicit and checkable.
#   cogito examples/bank.cog      runs the program
#   cogito verify examples/bank.cog  checks the contracts with random inputs

# Every Account satisfies its `where` clause: it is checked whenever one is
# built or changed, and `verify` generates only accounts that satisfy it.
type Account = { owner: Str, balance: Int }
  where balance >= 0 and balance <= 1_000_000_000_000

let max_balance = 1_000_000_000_000

type TxError =
  | InsufficientFunds(needed: Int, available: Int)
  | InvalidAmount(amount: Int)
  | LimitExceeded(limit: Int)

fn deposit(acct: Account, amount: Int) -> Result[Account, TxError]
  ensures match result {
    Ok(a) => a.balance == acct.balance + amount
    Err(_) => true
  }
{
  if amount <= 0 {
    return Err(InvalidAmount(amount))
  }
  if amount > max_balance - acct.balance {
    return Err(LimitExceeded(max_balance))
  }
  Ok({ ..acct, balance: acct.balance + amount })
}

fn withdraw(acct: Account, amount: Int) -> Result[Account, TxError]
  ensures match result {
    Ok(a) => a.balance == acct.balance - amount
    Err(_) => true
  }
{
  if amount <= 0 {
    return Err(InvalidAmount(amount))
  }
  if amount > acct.balance {
    return Err(InsufficientFunds(needed: amount, available: acct.balance))
  }
  Ok({ ..acct, balance: acct.balance - amount })
}

fn transfer(from: Account, to: Account, amount: Int) -> Result[(Account, Account), TxError]
  ensures match result {
    Ok((a, b)) => a.balance + b.balance == from.balance + to.balance
    Err(_) => true
  }
{
  let a = withdraw(from, amount)?
  let b = deposit(to, amount)?
  Ok((a, b))
}

fn describe(e: TxError) -> Str => match e {
  InsufficientFunds(needed, available) => "insufficient funds: needed {needed}, have {available}"
  InvalidAmount(amount) => "invalid amount {amount}"
  LimitExceeded(limit) => "the balance would exceed {limit}"
}

fn main() {
  let alice = Account(owner: "Alice", balance: 100)
  let bob = Account(owner: "Bob", balance: 20)

  match transfer(alice, bob, 30) {
    Ok((a, b)) => print("{a.owner}: {a.balance}, {b.owner}: {b.balance}")
    Err(e) => print("transfer failed: {e.describe()}")
  }
  match transfer(bob, alice, 500) {
    Ok(_) => print("unexpected success")
    Err(e) => print("transfer failed: {e.describe()}")
  }
  match withdraw(alice, -5) {
    Ok(_) => print("unexpected success")
    Err(e) => print("withdraw failed: {e.describe()}")
  }
}

property "money is conserved" (x: Account, y: Account, amount: Int) {
  match transfer(x, y, amount) {
    Ok((x2, y2)) => assert x2.balance + y2.balance == x.balance + y.balance
    Err(_) => assert true
  }
}
