# This program was written with habits from Python and JavaScript.
# Press Check to see what Cogito says, then Fix to rewrite them, then Run.

fn average(xs: List[Float]): Float {
  if xs.length() == 0 { return 0.0 }
  xs.sum() / xs.length()
}

fn grade(score: Float) -> String {
  if score >= 90.0 && score <= 100.0 {
    return 'A'
  } elif score >= 75.0 {
    return "B"
  }
  "C"
}

let scores = {"ana": 93.5, "ben": 71.0, "cy": 88.0}
var names = scores.keys()
names.sort()
for name in names {
  let s = scores[name]
  print(f"{name}: {s} -> {grade(s)}")
}
// who passed, and the class average
let passed = names.filter(n => grade(scores[n]) != "C")
if !passed.isEmpty() { console.log("passed: {passed.join(", ")}") }
print("average: {average(scores.values()):.2f}, best: {Math.max(scores["ana"], scores["cy"])}")
